# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never expose to the client
SUPABASE_ANON_KEY=                  # public/anon key — used for the advertiser dashboard's RLS-scoped reads (lib/supabase-clerk.ts)

# Scan privacy — see docs/privacy-policy.md
IP_HASH_SALT=                       # any long random string; IPs are hashed with this, never stored raw

# Web push (advertiser notifications — lib/push.ts, public/sw.js)
VAPID_PUBLIC_KEY=                   # generate with `npx web-push generate-vapid-keys`
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=       # same value as VAPID_PUBLIC_KEY, duplicated so the browser bundle can read it

# Clerk (advertiser sign-in for /dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Admin access to /admin (create ad_slots + download QR codes) — a
# comma-separated list of Clerk user ids, e.g. "user_abc,user_def". Get a
# user's id from Clerk → Users. Leave empty and nobody can reach /admin.
ADMIN_USER_IDS=

# Stripe (self-serve slot reservation at /reserve)
STRIPE_SECRET_KEY=                  # Stripe dashboard → Developers → API keys. Use a test-mode key first.
STRIPE_WEBHOOK_SECRET=              # From the webhook endpoint you register in Stripe pointing at
                                     # https://<your-domain>/api/webhooks/stripe — only exists once this is deployed.
